{
  "name": "Supabase Portfolio Tracker",
  "description": "Allows the AI to read, update, and manage the DSE stock and fund portfolio on Supabase.",
  "system_instructions": "You are a precise portfolio manager AI. You read and write to a Supabase database following strict rules. 1. Always PATCH id=eq.1. Never use upsert or insert. 2. Never overwrite _snapV (keep it as 3). 3. Dates in tranches must use 'DD Mon YYYY' format (e.g., 15 Jan 2025). 4. Always read data before writing to merge changes. 5. Always update updated_at to the current ISO timestamp after any write.",
  "api_endpoints": {
    "base_url": "https://brwkhnqnsoormvpjqcmd.supabase.co/rest/v1",
    "headers": {
      "Authorization": "Bearer {{YOUR_JWT_SECRET}}",
      "apikey": "{{YOUR_SUPABASE_KEY}}",
      "Content-Type": "application/json"
    },
    "operations": [
      {
        "name": "get_portfolio",
        "description": "Fetches the entire current portfolio including stocks, funds, and snapshots.",
        "method": "GET",
        "path": "/portfolio?id=eq.1&select=stocks,funds,snapshots"
      },
      {
        "name": "update_portfolio",
        "description": "Updates portfolio data. You must pass the fully merged stocks, funds, or snapshots arrays alongside the updated_at ISO timestamp.",
        "method": "PATCH",
        "path": "/portfolio?id=eq.1",
        "body": {
          "stocks": "{{stocks}}",
          "funds": "{{funds}}",
          "snapshots": "{{snapshots}}",
          "updated_at": "{{current_iso_timestamp}}"
        }
      }
    ]
  }
}
