/**
 * Google AI Edge Gallery Custom JS Skill Handler
 */
async function execute(toolName, arguments, secrets) {
  const endpoint = "https://brwkhnqnsoormvpjqcmd.supabase.co/rest/v1/portfolio?id=eq.1";
  
  // Grab the keys safely from the secure input fields inside the app
  const apiKey = secrets.SUPABASE_KEY;
  const authToken = secrets.AUTH_TOKEN;

  if (!apiKey || !authToken) {
    return JSON.stringify({ error: "Missing required setup tokens. Please check your app skill settings." });
  }

  try {
    // Perform a real live network fetch directly from the iPad browser engine
    const response = await fetch(endpoint, {
      method: "GET",
      headers: {
        "apikey": apiKey,
        "Authorization": `Bearer ${authToken}`,
        "Content-Type": "application/json"
      }
    });

    if (!response.ok) {
      return JSON.stringify({ error: `Supabase returned error code status: ${response.status}` });
    }

    const data = await response.json();
    
    // Send the live data back to the AI model's context window
    return JSON.stringify({
      status: "Success",
      message: "Fetched fresh data from Supabase instance.",
      liveData: data
    });

  } catch (err) {
    return JSON.stringify({ error: `Connection failed: ${err.message}` });
  }
}
